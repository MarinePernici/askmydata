@startuml AskMyData_System_Use_Cases

title AskMyData — System Use Cases

left to right direction

skinparam packageStyle rectangle

actor User
actor Administrator
actor "External Data Source\n(PostgreSQL)" as DataSource
actor "LLM Provider" as LLMProvider

rectangle "AskMyData" {

  package "Authentication" {

    usecase "Authenticate" as UC01

  }

  package "Project Management" {

    usecase "Create and Initialize\nProject" as UC02
    usecase "Update Project\nInformation" as UC09
    usecase "Archive Project" as UC10

  }

  package "Knowledge Catalog" {

    usecase "Explore Knowledge\nCatalog" as UC03
    usecase "Regenerate Knowledge\nCatalog" as UC08

  }

  package "Conversational Exploration" {

    usecase "Ask a Question" as UC04
    usecase "Clarify a Question" as UC05
    usecase "Continue a\nConversation" as UC06
    usecase "Manage\nConversations" as UC07

  }

  package "Data Schema" {

    usecase "Explore Data\nSchema" as UC12

  }

  package "Administration" {

    usecase "Manage Platform\nAccess" as UC11

  }

}

