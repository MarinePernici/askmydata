left to right direction

actor "User" as User
actor "AI Agent" as Agent
actor "Data Source\n(PostgreSQL)" as DataSource

rectangle "AskMyData" {

  usecase "Create project" as UC01
  usecase "Edit project" as UC02
  usecase "Delete project" as UC03

  usecase "Add data source" as UC04
  usecase "Test connection" as UC05
