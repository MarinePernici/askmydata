  usecase "Ask question" as UC07
  usecase "Generate SQL query" as UC08
  usecase "Validate SQL query" as UC09
  usecase "Execute read-only query" as UC10
  usecase "Generate natural language answer" as UC11

  usecase "View history" as UC12
  usecase "Change language" as UC13
}

User --> UC01
User --> UC02
User --> UC03
User --> UC04
User --> UC06
User --> UC07
User --> UC12
User --> UC13

UC04 --> UC05 : <<include>>
UC07 --> UC08 : <<include>>
UC07 --> UC09 : <<include>>
UC07 --> UC10 : <<include>>
