@startuml AskMyData_Conceptual_Components

title AskMyData - Conceptual Components

left to right direction
skinparam componentStyle rectangle

actor User

component "Frontend" as Frontend

component "Application Core" as Core {
  component "Project Management" as ProjectManagement
  component "Data Source Management" as DataSourceManagement
  component "Internationalization" as I18n
  component "History Management" as HistoryManagement
}

component "Question Engine" as QuestionEngine {
  component "Schema Retriever" as SchemaRetriever
  component "Prompt Builder" as PromptBuilder
  component "SQL Generator" as SQLGenerator
  component "SQL Validator" as SQLValidator
  component "Query Executor" as QueryExecutor
  component "Answer Generator" as AnswerGenerator
}

component "Connector Layer" as Connectors {
  component "Connector Interface" as ConnectorInterface
  component "PostgreSQL Connector" as PostgreSQLConnector
  component "CSV Connector" as CSVConnector
  component "JSON Connector" as JSONConnector
  component "BigQuery Connector" as BigQueryConnector
  component "MongoDB Connector" as MongoDBConnector
}

database "Application Database" as AppDB
database "External Data Sources" as ExternalSources
cloud "LLM Provider" as LLM

User --> Frontend

Frontend --> ProjectManagement
Frontend --> DataSourceManagement
Frontend --> QuestionEngine
Frontend --> HistoryManagement
Frontend --> I18n

ProjectManagement --> AppDB
DataSourceManagement --> AppDB
HistoryManagement --> AppDB

QuestionEngine --> SchemaRetriever
QuestionEngine --> PromptBuilder
QuestionEngine --> SQLGenerator
QuestionEngine --> SQLValidator
QuestionEngine --> QueryExecutor
QuestionEngine --> AnswerGenerator

SchemaRetriever --> ConnectorInterface
QueryExecutor --> ConnectorInterface

ConnectorInterface <|.. PostgreSQLConnector
ConnectorInterface <|.. CSVConnector
ConnectorInterface <|.. JSONConnector
ConnectorInterface <|.. BigQueryConnector
ConnectorInterface <|.. MongoDBConnector

PostgreSQLConnector --> ExternalSources
CSVConnector --> ExternalSources
JSONConnector --> ExternalSources
BigQueryConnector --> ExternalSources
MongoDBConnector --> ExternalSources

PromptBuilder --> LLM
SQLGenerator --> LLM
AnswerGenerator --> LLM

@enduml