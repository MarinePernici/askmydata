# Application
APP_ENV=development

# Public domain used by Caddy in production
# Example: demo.example.com (without protocol)
APP_DOMAIN=

# Django
DJANGO_SECRET_KEY=change_me
DJANGO_DEBUG=True
# Django allowed hosts (comma-separated, without http:// or https://)
# Local: localhost,127.0.0.1
# Production: demo.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Trusted origins for CSRF protection (comma-separated, including protocol)
# Leave empty for local HTTP development
# Production: https://demo.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Application database
DATABASE_URL=postgresql://askmydata:change_me@localhost:5432/askmydata

# External PostgreSQL test source
TEST_SOURCE_DB_HOST=localhost
TEST_SOURCE_DB_PORT=5432
TEST_SOURCE_DB_NAME=askmydata_test_source
TEST_SOURCE_DB_USER=askmydata_readonly
TEST_SOURCE_DB_PASSWORD=change_me

TEST_WRITABLE_DB_USER=askmydata_writable_test
TEST_WRITABLE_DB_PASSWORD=change_me

TEST_NOSELECT_DB_USER=askmydata_noselect_test
TEST_NOSELECT_DB_PASSWORD=change_me

# Application PostgreSQL database
POSTGRES_DB=askmydata
POSTGRES_USER=askmydata
POSTGRES_PASSWORD=change_me
DATABASE_URL_DOCKER=postgresql://askmydata:change_me@db:5432/askmydata

# LLM
OPENAI_API_KEY=change_me
LLM_MODEL=gpt-5-mini

# Data Sources
DATASOURCE_ENCRYPTION_KEY=change_me

# OpenTelemetry
OTEL_ENABLED=False
OTEL_SERVICE_NAME=askmydata
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER_ARG=1.0

# Public Demo
# Automatically enabled by compose.demo.yaml
PUBLIC_DEMO_MODE=False

# Demo PostgreSQL connection
# Automatically configured by compose.demo.yaml
DEMO_DB_HOST=demo-db
DEMO_DB_PORT=5432

# Demo database credentials
DEMO_DB_ADMIN_PASSWORD=your_demo_db_admin_password
DEMO_PAGILA_PASSWORD=your_demo_pagila_password
DEMO_EEG_PASSWORD=your_eeg_password
DEMO_OLIST_PASSWORD=your_olist_password
DEMO_BADMINTON_PASSWORD=your_badminton_password

# Public Demo usage limits
DEMO_MAX_PROJECTS_PER_USER=5
DEMO_MAX_DAILY_QUESTIONS=30
DEMO_MAX_DAILY_CATALOG_BUILDS=10
DEMO_MAX_QUESTION_LENGTH=2000
